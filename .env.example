# Motor de base de datos: postgresql (default) | sqlite | mysql | sqlserver
DB_ENGINE=postgresql

# PostgreSQL
DB_NAME=elmorro
DB_USER=elmorro
DB_PASSWORD=cambiar_esta_clave
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

# Alternativa temporal (rollback): export DB_ENGINE=sqlite
# SQLITE_NAME=/ruta/absoluta/db/elmorro.sqlite3
